# uploader/pengy_api.py
import time

print(">>> NEW PENGY_API LOADED <<<")

try:
    # ako imaš već base uploader kao kod sensor.community
    from uploader.base import BaseUploader
except ImportError:
    # fallback, da ne pukne ako ga još nema
    class BaseUploader:
        def __init__(self, config, device):
            self.config = config
            self.device = device


class PengyApiUploader(BaseUploader):
    """
    THIS IS UPDATED VERSION TO 2025-11-25-01
    Skeleton uploader za tvoj budući API.
    Ideja:
    - čita config["external"]["pengy_api"]
    - proverava da li je enabled
    - eventualno radi na intervalu (da ne šalje svaki minut)
    - send(...) za sad samo štampa šta bi poslalo
    """

    def __init__(self, config: dict, device: dict):
        super().__init__(config, device)

        ext_cfg = config.get("external", {})
        self.cfg = ext_cfg.get("pengy_api", {})  # da bude kraće

        self.enabled = self.cfg.get("enabled", False)
        self.base_url = self.cfg.get("base_url", "")
        self.api_key = self.cfg.get("api_key", "")

        # koliki je interval slanja (sekunde) – za sad 60s default
        self.interval_seconds = self.cfg.get("interval_seconds", 60)

        # kad smo poslednji put slali
        self.last_sent = 0

    def is_enabled(self) -> bool:
        return self.enabled and bool(self.base_url)

    def should_send(self, now_ts: int) -> bool:
        """
        ExternalManager te zove za svako merenje i prosleđuje now_ts.
        Ovde odlučuješ da li je vreme da se šalje.
        """
        if not self.is_enabled():
            return False

        # ako interval nije prošao, ne šaljemo
        if (now_ts - self.last_sent) < self.interval_seconds:
            return False

        return True

    def send(self, measurement: dict):
        """
        Za sad ne zovemo nikakav HTTP.
        Samo pokažemo šta bismo poslali i osvežimo last_sent.
        Kasnije ovde dodaš urequests.post(...)
        """
        now_ts = int(time.time())

        if not self.is_enabled():
            return

        # ovde bi pravio payload, npr:
        payload = {
            "device": self.device,
            "measurement": measurement,
            "ts": now_ts,
        }

        # za sad samo štampamo
        print("[PengyAPI] would send to:", self.base_url)
        print("[PengyAPI] payload:", payload)

        # označi da je poslato
        self.last_sent = now_ts
