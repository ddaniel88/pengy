# sensors/sps30.py
# SPS30
import time
import struct
from sensors.base import BaseEnvSensor
from sensors.pm_validation import invalid_pm

I2C_ADDR = 0x69
CLEANING_SETTLE_MS = 40000


class Sps30CRCError(ValueError):
    pass


def _crc8(two_bytes: bytes) -> int:
    crc = 0xFF
    for b in two_bytes:
        crc ^= b
        for _ in range(8):
            if crc & 0x80:
                crc = ((crc << 1) ^ 0x31) & 0xFF
            else:
                crc = (crc << 1) & 0xFF
    return crc


class Sps30Sensor(BaseEnvSensor):
    """
    SPS30 adapter.
    Vraća samo mass-koncentracije (prve 4 vrednosti):
      - pm1
      - pm2_5
      - pm4
      - pm10
    Ostale (number concentration...) za sada ignorišemo.
    """

    def __init__(self, i2c, diagnostics=False):
        self.i2c = i2c
        self._started = False
        self.probe = None
        self._pm_resume_ms = None
        self._diagnostics = None
        self.capture = None
        if diagnostics is True:
            try:
                from sensors.sps30_diag import Sps30Diagnostics
                self._diagnostics = Sps30Diagnostics()
            except Exception:
                pass

    def _diag_call(self, method, *args):
        # Optional diagnostics must never prevent a measurement.
        try:
            return getattr(self._diagnostics, method)(*args)
        except Exception:
            return None

    def _capture_call(self, method, *args):
        try:
            if self.capture is not None:
                return getattr(self.capture, method)(*args)
        except Exception:
            pass
        return None

    def get_diagnostics(self):
        if self._diagnostics is not None:
            return self._diag_call("snapshot")
        return None

    def get_supported_fields(self):
        # ovde koristimo nazive kao u config.json
        return ["pm1", "pm2_5", "pm4", "pm10"]

    def _start_measurement(self):
        # komanda 0x0010, payload 0x03 0x00 (float), pa CRC
        payload = b"\x03\x00"
        c = _crc8(payload)
        packet = b"\x00\x10" + payload + bytes([c])
        self.i2c.writeto(I2C_ADDR, packet)
        self._started = True
        self._capture_call("started")

    def _read_raw_frame(self):
        # set pointer na 0x0300 pa čitanje 60 bajtova
        self.i2c.writeto(I2C_ADDR, b"\x03\x00")
        data = self.i2c.readfrom(I2C_ADDR, 60)
        return bytes(data)

    def _parse_10_floats(self, data: bytes):
        if len(data) != 60:
            raise ValueError("SPS30 short frame")
        vals = []
        for offset in range(0, 60, 6):
            hi = data[offset:offset+2]
            c1 = data[offset+2]
            lo = data[offset+3:offset+5]
            c2 = data[offset+5]

            if _crc8(hi) != c1 or _crc8(lo) != c2:
                vals.append(None)
                continue

            raw = hi + lo
            vals.append(struct.unpack(">f", raw)[0])
        return vals

    def _read_words(self, command, length):
        self.i2c.writeto(I2C_ADDR, command)
        data = self.i2c.readfrom(I2C_ADDR, length)
        if len(data) != length:
            raise ValueError("SPS30 short response")
        result = bytearray()
        for offset in range(0, length, 3):
            word = data[offset:offset + 2]
            if _crc8(word) != data[offset + 2]:
                raise Sps30CRCError("SPS30 CRC")
            result.extend(word)
        return result

    def read_version(self):
        data = self._read_words(b"\xd1\x00", 3)
        return (data[0], data[1])

    def read_product(self):
        return bytes(self._read_words(b"\xd0\x02", 12)).decode("ascii")

    def read_serial(self):
        return bytes(self._read_words(b"\xd0\x33", 48)).split(b"\x00", 1)[0].decode("ascii")

    def read_status(self):
        data = self._read_words(b"\xd2\x06", 6)
        raw = struct.unpack(">I", data)[0]
        return {"raw": raw, "fan_speed": bool(raw & (1 << 21)),
                "laser": bool(raw & (1 << 5)), "fan": bool(raw & (1 << 4))}

    def data_ready(self):
        data = self._read_words(b"\x02\x02", 3)
        if data[0] != 0 or data[1] not in (0, 1):
            raise ValueError("SPS30 ready flag")
        return data[1] == 1

    def stop_measurement(self):
        self.i2c.writeto(I2C_ADDR, b"\x01\x04")
        self._started = False

    def reset_sensor(self):
        self.i2c.writeto(I2C_ADDR, b"\xd3\x04")
        self._started = False

    def read_cleaning_interval(self):
        data = self._read_words(b"\x80\x04", 6)
        return struct.unpack(">I", data)[0]

    def cleaning_pending(self):
        if self._pm_resume_ms is None:
            return False
        if time.ticks_diff(time.ticks_ms(), self._pm_resume_ms) < 0:
            return True
        self._pm_resume_ms = None
        return False

    def start_fan_cleaning(self):
        if not self._started:
            raise RuntimeError("SPS30 cleaning requires measurement mode")
        # A failed write may have reached the sensor. Do not retry, and keep
        # stale/settling values out of normal output even if the probe cancels.
        self._pm_resume_ms = time.ticks_add(time.ticks_ms(), CLEANING_SETTLE_MS)
        self.i2c.writeto(I2C_ADDR, b"\x56\x07")

    def measure_one_minute(self,
                           samples_count: int = 5,
                           interval_seconds: int = 1,
                           trim_extremes: bool = True):
        if (self.probe and self.probe.active) or self.cleaning_pending():
            return None
        diag = self._diagnostics
        self._capture_call("begin", samples_count, trim_extremes)
        if diag is not None:
            self._diag_call("begin", samples_count, trim_extremes)
        # pokreni merenje samo prvi put
        try:
            if not self._started:
                self._start_measurement()
                # SPS30 merenje ide u pozadini, ali dajemo mu malo vazduha
                time.sleep(1)
        except Exception as exc:
            self._capture_call("finish", None)
            if diag is not None:
                self._diag_call("error", exc, True)
                self._diag_call("finish", None)
            raise

        samples = []
        rejected_pm = False

        for _ in range(samples_count):
            ready = self._capture_call("ready", self)
            held = None
            try:
                raw = self._read_raw_frame()
                held = self._capture_call("hold", raw, ready)
                vals = self._parse_10_floats(raw)
                if vals:
                    # prve 4 su nam bitne
                    sample = {
                        "pm1": vals[0],
                        "pm2_5": vals[1],
                        "pm4": vals[2],
                        "pm10": vals[3],
                    }
                    bad_pm = invalid_pm(sample)
                    accepted = False
                    if bad_pm:
                        rejected_pm = True
                    elif all(value is not None for value in vals[:4]):
                        samples.append(sample)
                        accepted = True
                    if diag is not None:
                        self._diag_call("frame", vals, accepted, bad_pm)
                    self._capture_call("record", held, ready, vals, accepted, bad_pm)
            except Exception as exc:
                self._capture_call("record", held, ready, None, False, False, exc)
                # ako jedan sample omane, samo nastavi
                if diag is not None:
                    self._diag_call("error", exc)

            time.sleep(interval_seconds)

        # Do not hide an out-of-range sample by trimming or averaging it away.
        if rejected_pm:
            self._capture_call("finish", None)
            print("[SPS30] PM cycle rejected: invalid value or outside 0..1000")
            if diag is not None:
                self._diag_call("finish", None)
            return None

        if not samples:
            self._capture_call("finish", None)
            if diag is not None:
                self._diag_call("finish", None)
            return None

        # helper za proseke
        def avg(key):
            values = [s[key] for s in samples if s.get(key) is not None]
            if not values:
                return None
            values = sorted(values)
            if trim_extremes and len(values) > 2:
                values = values[1:-1]
            return sum(values) / len(values)

        result = {
            "pm1": avg("pm1"),
            "pm2_5": avg("pm2_5"),
            "pm4": avg("pm4"),
            "pm10": avg("pm10"),
        }
        if diag is not None:
            self._diag_call("finish", result)
        self._capture_call("finish", result)
        return result
